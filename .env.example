# Skopiuj ten plik jako .env.local i uzupełnij wartościami.

# Google OAuth2 (zalecane — omija limity Service Account)
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_client_secret"
GOOGLE_REFRESH_TOKEN="your_refresh_token"

# Fallback tylko gdy OAuth nie jest ustawiony (niezalecane na produkcji)
# GOOGLE_SERVICE_ACCOUNT_EMAIL="twoje-konto@twoj-projekt.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID głównego folderu Drive na sesje uploadu
GOOGLE_DRIVE_FOLDER_ID="your_folder_id"

# SMTP (powiadomienia po uploadzie)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="your_email@gmail.com"
NOTIFICATION_EMAIL="your_destination_email@gmail.com"

# Opcjonalny webhook (Discord/Slack) — POST JSON z content
WEBHOOK_URL=""

# Tokeny uploadu (fallback gdy Drive store niedostępny). Link: https://domena/?token=ClientA
UPLOAD_TOKENS="ClientA,ClientB"

# Konsola admina (/admin)
ADMIN_SECRET="zmien-na-silne-haslo"

# Publiczny URL (linki w /admin i Studio Console)
PUBLIC_UPLOAD_URL="https://your-domain.com"

# Opcjonalnie
# MAX_FILE_SIZE_GB="250"
# SHARE_UPLOAD_MAX_FILES_PER_DAY="200"
# SHARE_UPLOAD_MAX_BYTES_PER_DAY="5368709120"
