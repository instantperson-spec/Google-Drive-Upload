# Skopiuj ten plik i zmień jego nazwę na .env.local, a następnie uzupełnij swoimi danymi.

GOOGLE_SERVICE_ACCOUNT_EMAIL="twoje-konto@twoj-projekt.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTWOJ_DLUGI_KLUCZ_Z_PLIKU_JSON\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="ID_UDOSTEPNIONEGO_FOLDERU"

# Jeśli chcesz powiadomienia na Discordzie/Slacku, wklej tu adres URL Webhooka
WEBHOOK_URL=""

# Lista ważnych tokenów dostępu (per projekt/klient), rozdzielonych przecinkami.
# Klient otwiera stronę z linkiem: https://twoja-domena.pl/?token=ProjektAlfa
UPLOAD_TOKENS="ProjektAlfa,KlientBeta2026"

# Hasło do konsoli admina (/admin)
ADMIN_SECRET="zmien-na-silne-haslo"
