{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Console",
  "version": "0.1.0",
  "identifier": "local.drive-uploader.studio-console",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8787",
    "beforeBuildCommand": "npm run build:stub",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
